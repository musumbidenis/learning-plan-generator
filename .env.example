# Copy to .env and fill in your key.
# Google Gemini API key (AI Studio). Used via ?key=<GEMINI_API_KEY> (NOT Bearer).
GEMINI_API_KEY=your_key_here

# Optional model overrides. The app walks an ordered "switch case" chain and uses
# the first model that responds (skipping any that are quota-limited / 429).
#
# NOTE: on free-tier keys Google currently reports `quota limit: 0` for the whole
# Gemini 2.0 family and the *-pro tiers, so 2.0 only works on a BILLING-ENABLED
# key. The built-in chain lists 2.0 first (preferred) and falls through to the
# flash models that work on free-tier keys (2.5 / 3.x).
#
# GEMINI_MODEL sets the primary; GEMINI_FALLBACK_MODELS is a comma-separated rest.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-flash-latest
