# Copy this file to .env and fill in your own values. NEVER commit .env.
# Get a Mistral key at https://console.mistral.ai/api-keys.

# Required: your Mistral API key.
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: override the model chain. Omit both to use the built-in default
# (mistral-large-latest -> mistral-medium-latest -> mistral-small-latest).
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_FALLBACK_MODELS=mistral-medium-latest,mistral-small-latest
