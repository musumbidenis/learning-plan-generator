# Copy this file to .env and fill in your own values. NEVER commit .env.
# Get a Mistral key at https://console.mistral.ai/api-keys.

# Required: your Mistral API key.
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: override the model. Omit to use the built-in default.
# MISTRAL_MODEL=mistral-small-latest

# Optional: a Google API key, which turns on the shared Drive document library
# (browse collection -> programme instead of uploading the two PDFs each time).
# Console -> new project -> enable the Google Drive API -> Credentials ->
# Create credentials -> API key, then restrict it to the Drive API.
# Read-only: the app never writes to Drive. Omit it and the upload flow is used.
# GOOGLE_API_KEY=your-google-api-key-here

# Optional: point the library at a different Drive folder. Defaults to the
# shared "Training Tools" folder. The folder must be shared with
# "Anyone with the link -> Viewer" for the API key to read it.
# DRIVE_LIBRARY_FOLDER_ID=1dGIPeezcayb-xHSYZsPa0MGv3clkRMGi
