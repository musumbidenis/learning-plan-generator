# Copy this file to .env and fill in your own values. NEVER commit .env.
# Get a Gemini key at https://aistudio.google.com (API keys).

# Required: your Google Gemini API key.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the model chain. Omit both to use the built-in default
# (gemini-2.0-flash -> ... -> gemini-2.5-flash and friends).
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
