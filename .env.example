# Copy this file to .env and fill in your own values. NEVER commit .env.
# Get a Mistral key at https://console.mistral.ai/api-keys.

# Required: your Mistral API key.
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: the model to prefer. Omit for the built-in default,
# mistral-small-latest. This is a preference, not a guarantee: if your plan
# doesn't include it, the app asks Mistral which models the key can call and
# uses the most capable one that answers. Naming a model your plan does allow
# skips that search.
# MISTRAL_MODEL=mistral-small-latest

# Optional: a Google API key, which turns on the shared Drive document library
# (pick a programme instead of uploading the two PDFs each time).
# Console -> new project -> enable the Google Drive API -> Credentials ->
# Create credentials -> API key, then restrict it to the Drive API.
# Read-only: the app never writes to Drive. Omit it and the upload flow is used.
# GOOGLE_API_KEY=your-google-api-key-here

# Optional: point the library at a different Drive folder. Defaults to the
# shared "Occupational Standards and CBET Curriculum" folder. The folder must be
# shared with "Anyone with the link -> Viewer" for the API key to read it. It
# may hold the programme folders directly, or group them under a further level.
# DRIVE_LIBRARY_FOLDER_ID=11gAs0Y3zLmPj4mykyKzjBWy-0TxT3mbU
